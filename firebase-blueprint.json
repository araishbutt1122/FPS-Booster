{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile with gaming boost status and pro subscription details",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "User gamer tag or name",
          "maxLength": 64
        },
        "deviceId": {
          "type": "string",
          "description": "Unique device or anonymous auth ID",
          "maxLength": 128
        },
        "isPro": {
          "type": "boolean",
          "description": "Whether the user has PRO VIP access"
        },
        "proExpiry": {
          "type": "number",
          "description": "Expiration timestamp in milliseconds"
        },
        "totalBoostTime": {
          "type": "number",
          "description": "Total accumulated boost time in seconds"
        },
        "activeFps": {
          "type": "string",
          "description": "Active FPS mode (60, 90, 120)",
          "enum": ["60", "90", "120"]
        },
        "activeProfile": {
          "type": "string",
          "description": "Active optimization profile",
          "enum": ["SMART_BOOST", "PERFORMANCE_MODE", "EXTREME_MODE", "BALANCED_MODE", "BATTERY_SAVER"]
        },
        "lastBoostTime": {
          "type": "string",
          "description": "Timestamp string of last boost"
        },
        "createdAt": {
          "type": "string",
          "description": "ISO creation time"
        }
      },
      "required": ["name", "deviceId", "isPro"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Submitted payment transaction proof for pro subscription",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User Auth UID who submitted the payment",
          "maxLength": 128
        },
        "name": {
          "type": "string",
          "description": "Sender name",
          "maxLength": 64
        },
        "packageName": {
          "type": "string",
          "description": "Subscribed package name",
          "maxLength": 64
        },
        "amount": {
          "type": "number",
          "description": "Payment amount in PKR or USD"
        },
        "method": {
          "type": "string",
          "description": "Payment gateway method",
          "enum": ["jazzcash", "easypaisa", "binance"]
        },
        "tid": {
          "type": "string",
          "description": "Transaction ID from receipt",
          "maxLength": 64
        },
        "screenshotUrl": {
          "type": "string",
          "description": "Screenshot URL or base64 data"
        },
        "status": {
          "type": "string",
          "description": "Verification status",
          "enum": ["pending", "approved", "rejected"]
        },
        "createdAt": {
          "type": "number",
          "description": "Creation timestamp ms"
        },
        "reviewedAt": {
          "type": "number",
          "description": "Review timestamp ms"
        }
      },
      "required": ["userId", "packageName", "amount", "method", "tid", "status"]
    },
    "AdminStats": {
      "title": "AdminStats",
      "description": "Global wallet and collection statistics",
      "type": "object",
      "properties": {
        "totalEarnings": {
          "type": "number",
          "description": "Total earnings in PKR"
        },
        "todayEarnings": {
          "type": "number",
          "description": "Today's earnings in PKR"
        },
        "totalProUsers": {
          "type": "number",
          "description": "Total PRO users count"
        }
      },
      "required": ["totalEarnings", "todayEarnings", "totalProUsers"]
    },
    "RemoteConfig": {
      "title": "RemoteConfig",
      "description": "Cloud backend configuration, update notices, and server status",
      "type": "object",
      "properties": {
        "configVersion": { "type": "string", "maxLength": 32 },
        "minAppVersion": { "type": "string", "maxLength": 32 },
        "serviceStatus": { "type": "string", "enum": ["operational", "degraded", "maintenance"] },
        "updateTitle": { "type": "string", "maxLength": 120 },
        "updateMessage": { "type": "string", "maxLength": 300 },
        "hasImportantUpdate": { "type": "boolean" },
        "telemetryEnabled": { "type": "boolean" },
        "updatedAt": { "type": "number" }
      },
      "required": ["configVersion", "serviceStatus", "hasImportantUpdate"]
    },
    "OptimizationProfile": {
      "title": "OptimizationProfile",
      "description": "Remote gaming optimization preset profile",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 48 },
        "name": { "type": "string", "maxLength": 64 },
        "description": { "type": "string", "maxLength": 200 },
        "targetFps": { "type": "string", "enum": ["60", "90", "120"] },
        "performanceMode": { "type": "boolean" },
        "reduceLag": { "type": "boolean" },
        "improveRendering": { "type": "boolean" },
        "graphicsOptimized": { "type": "boolean" },
        "thermalCapC": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name", "targetFps"]
    },
    "DeviceCompatibility": {
      "title": "DeviceCompatibility",
      "description": "Device hardware capability and compatibility record",
      "type": "object",
      "properties": {
        "deviceId": { "type": "string", "maxLength": 128 },
        "deviceName": { "type": "string", "maxLength": 128 },
        "maxSupportedHz": { "type": "number" },
        "totalRamGb": { "type": "number" },
        "adpfSupported": { "type": "boolean" },
        "gameModeApiSupported": { "type": "boolean" },
        "vpnFirewallSupported": { "type": "boolean" },
        "recommendedProfile": { "type": "string", "maxLength": 48 },
        "compatibilityTier": { "type": "string", "enum": ["FLAGSHIP", "COMPETITIVE", "STANDARD", "WEB_PREVIEW"] },
        "updatedAt": { "type": "number" }
      },
      "required": ["deviceId", "deviceName", "maxSupportedHz", "compatibilityTier"]
    },
    "CrashDiagnostic": {
      "title": "CrashDiagnostic",
      "description": "Client runtime error or crash diagnostic record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "message": { "type": "string", "maxLength": 500 },
        "stack": { "type": "string", "maxLength": 2000 },
        "screen": { "type": "string", "maxLength": 48 },
        "platform": { "type": "string", "maxLength": 32 },
        "appVersion": { "type": "string", "maxLength": 32 },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "message", "createdAt"]
    },
    "PerformanceReport": {
      "title": "PerformanceReport",
      "description": "Gaming session performance telemetry summary report",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "gameName": { "type": "string", "maxLength": 80 },
        "profileMode": { "type": "string", "maxLength": 48 },
        "avgFps": { "type": "number" },
        "minFps": { "type": "number" },
        "maxFps": { "type": "number" },
        "avgPingMs": { "type": "number" },
        "packetLossPercent": { "type": "number" },
        "peakTempC": { "type": "number" },
        "blockedAppsCount": { "type": "number" },
        "durationSec": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "gameName", "profileMode", "avgFps", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profiles and subscription state"
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "Payment" },
      "description": "All payment submissions and approval statuses"
    },
    "/admin/stats": {
      "schema": { "$ref": "AdminStats" },
      "description": "Aggregated wallet stats"
    },
    "/cloudConfig/{configId}": {
      "schema": { "$ref": "RemoteConfig" },
      "description": "Remote configuration updates and health status"
    },
    "/optimizationProfiles/{profileId}": {
      "schema": { "$ref": "OptimizationProfile" },
      "description": "Server-managed optimization profiles"
    },
    "/deviceProfiles/{deviceId}": {
      "schema": { "$ref": "DeviceCompatibility" },
      "description": "Device hardware compatibility database"
    },
    "/crashReports/{reportId}": {
      "schema": { "$ref": "CrashDiagnostic" },
      "description": "Application crash diagnostics"
    },
    "/performanceReports/{reportId}": {
      "schema": { "$ref": "PerformanceReport" },
      "description": "Gaming session performance reports"
    }
  }
}
